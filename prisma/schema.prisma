generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id        String   @id @default(uuid())
  slug      String   @unique
  num       String   @default("00")
  title     String
  subtitle  String   @default("")
  category  String   @default("")
  location  String   @default("")
  year      String   @default("")
  heroImg   String   @default("") @map("hero_img")
  story     String   @default("")
  pullQuote String?  @map("pull_quote")
  
  gallery   GalleryImage[]
  specs     Spec[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model GalleryImage {
  id        String  @id @default(uuid())
  src       String
  span      String  @default("half") // "full" | "half"
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model Spec {
  id        String  @id @default(uuid())
  label     String
  value     String
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("specs")
}

model Journal {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  date      String
  category  String   @default("ESSAY")
  heroImg   String   @map("hero_img")
  content   String   @db.Text
  
  readTime  String?  @map("read_time")
  excerpt   String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("journal")
}

model SiteSettings {
  id        String   @id @default("global")
  phone     String   @default("+91 7306358793")
  email     String   @default("kalaakaarsarchitecture@gmail.com")
  address   String   @default("Opposite Hill Fort Auditorium Gate, Pathanapuram, Areekode, Malappuram")
  yearsExp  String   @default("8") @map("years_exp")
  
  instagram String?
  linkedin  String?
  
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
